    {
      "id": "e_pr",
      "from": "review",
      "to": "pr",
      "label": "protected base",
      "variant": "emphasis",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "e_auto",
      "from": "review",
      "to": "auto_merge",
      "label": "PR gate off",
      "variant": "dashed",
      "role": "branch",
      "fromSide": "top",
      "toSide": "right"
    },
    {
      "id": "e_merge",
      "from": "pr",
      "to": "you_merge",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Gates are settings",
      "items": [
        "Spec and PR gates on by default, plan gate off",
        "Set globally, per repo or per task",
        "Spec changes go back to spec-writer",
        "dev, stg and main always wait for you"
      ]
    },
    {
      "dot": "amber",
      "title": "Fix loop",
      "items": [
        "Failed tests go back to the implementer",
        "Reviewer change requests go back too",
        "After the 3rd failed try the task is Blocked"
      ]
    },
    {
      "dot": "violet",
      "title": "Every move is recorded",
      "items": [
        "Only the core writes to the Board",
        "Each change adds a history row: who, what, why",
        "History rows can never be edited or deleted"
      ]
    },
    {
      "dot": "rose",
      "title": "Agents hold no keys",
      "items": [
        "Agents edit code in their worktree only",
        "The core pushes, opens PRs and merges",
        "Hooks block git push and secret files"
      ]
    }
  ]
}