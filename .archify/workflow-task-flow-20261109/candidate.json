      "id": "e_plan",
      "from": "spec_gate",
      "to": "plan",
      "label": "approved",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "e_build",
      "from": "plan",
      "to": "build",
      "variant": "default"
    },
    {
      "id": "e_verify",
      "from": "build",
      "to": "verify",
      "variant": "default"
    },
    {
      "id": "e_review",
      "from": "verify",
      "to": "review",
      "label": "pass",
      "variant": "emphasis"
    },
    {
      "id": "e_verify_back",
      "from": "verify",
      "to": "build",
